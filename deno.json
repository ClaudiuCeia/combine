{
  "name": "@claudiu-ceia/combine",
  "version": "0.6.2",
  "exports": {
    ".": "./mod.ts",
    "./nondeterministic": "./src/nondeterministic.ts",
    "./perf": "./src/perf.ts"
  },
  "publish": {
    "exclude": [
      ".github/",
      "AGENTS.md",
      "bench/",
      "deno.lock",
      "npm/",
      "scripts/",
      "tests/"
    ]
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno test --ignore=npm",
    "bench:comparison": "deno bench --allow-env=DEBUG bench/comparison_bench.ts",
    "bench:comparison:json": "deno bench --allow-env=DEBUG --json bench/comparison_bench.ts",
    "bench:verify": "deno run --allow-env=DEBUG bench/comparison_verify.ts",
    "coverage": "deno test --ignore=npm --clean --coverage=.coverage && deno coverage --detailed --html .coverage",
    "build:npm": "deno run -A scripts/build-npm.ts",
    "hooks:install": "ln -sf ../../scripts/pre-commit .git/hooks/pre-commit && chmod +x scripts/pre-commit",
    "hooks:uninstall": "rm -f .git/hooks/pre-commit"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@deno/dnt": "jsr:@deno/dnt@^0.43.2",
    "mini-parse": "npm:mini-parse@0.6.41",
    "parjs": "npm:parjs@1.3.9",
    "parjs/combinators": "npm:parjs@1.3.9/combinators",
    "parser-combinators": "npm:parser-combinators@1.2.7",
    "peberminta": "npm:peberminta@0.10.0",
    "peberminta/char": "npm:peberminta@0.10.0/char",
    "tarsec": "npm:tarsec@0.5.3"
  }
}
